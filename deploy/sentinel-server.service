[Unit]
Description=The Sentinel - OpenAPI tool server
Documentation=https://github.com/farukhanci/the-sentinel
After=network-online.target

[Service]
Type=exec
WorkingDirectory=%h/the-sentinel
Environment=PYTHONPATH=%h/the-sentinel
Environment=PYTHONUNBUFFERED=1

# Bound to the Docker bridge, not to 0.0.0.0. Open WebUI runs in a container
# and reaches the host through host.docker.internal, so it needs more than
# loopback - but `write`, `relocate` and `remove` are real and there is no
# authentication, so this is as wide as it should ever get. Check your own
# bridge address with: ip -4 addr show docker0
ExecStart=/usr/bin/python3 -m sentinel.server \
    --vault %h/obsidian/Obsidian-1 \
    --embed-model %h/models/multilingual-e5-small \
    --host 172.17.0.1 --port 8123

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
